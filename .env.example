# Optional: Conda environment name or absolute prefix. Defaults to CosmoConda.
LIMBERCLOUD_CONDA_ENV=CosmoConda

# Required: external data, configuration, results, and plots root.
LIMBERCLOUD_RUNTIME_ROOT=/absolute/path/to/LimberCloud-runtime

# Optional: required only for covariance jobs that call OneCovariance.
LIMBERCLOUD_ONECOVARIANCE_ROOT=/absolute/path/to/OneCovariance

# Optional: directory containing pdflatex when it is not already on PATH.
LIMBERCLOUD_TEXLIVE_BIN=/absolute/path/to/texlive/bin
